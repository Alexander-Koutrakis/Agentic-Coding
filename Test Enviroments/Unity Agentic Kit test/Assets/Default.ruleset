<?xml version="1.0" encoding="utf-8"?>
<!-- Severities for Microsoft.Unity.Analyzers 1.28.0 (Assets/Kit/Analyzers). Unity applies this file to every assembly
     under Assets; .editorconfig severities are NOT applied by Unity's compile (Task 003, B1 probe).
     error: correctness and type safety, so the compile gate fails. warning: performance, reported, not failing.
     Left at the default: UNT0005 (retired), UNT0021 (opt-in style), UNT0034/UNT0035 (readability), UNT0039 (design advice). -->
<RuleSet Name="Kit rules" Description="Severities for Microsoft.Unity.Analyzers" ToolsVersion="16.0">
  <Rules AnalyzerId="Microsoft.Unity.Analyzers" RuleNamespace="Microsoft.Unity.Analyzers">
    <!-- error: correctness and type safety -->
    <Rule Id="UNT0003" Action="Error" />
