#pragma kernel CSMain

StructuredBuffer<float4x4> _Blades;
AppendStructuredBuffer<uint> _Visible;
float4 _FrustumPlanes[6]; // xyz: inward normal, w: distance
uint _BladeCount;
float3 _BoundCenter;      // blade mesh bounds center, object space
float _BoundRadius;       // blade mesh bounds radius, object space

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _BladeCount)
        return;

    float4x4 m = _Blades[id.x];
    float3 center = mul(m, float4(_BoundCenter, 1.0)).xyz;
    float3 c0 = float3(m._m00, m._m10, m._m20);
    float3 c1 = float3(m._m01, m._m11, m._m21);
    float3 c2 = float3(m._m02, m._m12, m._m22);
    float radius = _BoundRadius * sqrt(max(dot(c0, c0), max(dot(c1, c1), dot(c2, c2))));

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        if (dot(_FrustumPlanes[i].xyz, center) + _FrustumPlanes[i].w < -radius)
            return;
    }

    _Visible.Append(id.x);
}
